# Supabase: адрес проекта и публичный ключ (видны в браузере)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase: служебный ключ, только на сервере и в скриптах
SUPABASE_SERVICE_ROLE_KEY=

# ИИ: cloud | local
AI_PROVIDER=cloud

# Секрет для вызова /api/cron/* из pg_cron
CRON_SECRET=

# Telegram (M2)
TELEGRAM_BOT_TOKEN=
