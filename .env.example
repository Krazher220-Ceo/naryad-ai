# Supabase: адрес проекта и публичный ключ (видны в браузере)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase: служебный ключ, только на сервере и в скриптах
SUPABASE_SERVICE_ROLE_KEY=

# ИИ: cloud | local
AI_PROVIDER=cloud

# Секрет для вызова /api/cron/* из pg_cron
CRON_SECRET=

# Telegram (M2)
TELEGRAM_BOT_TOKEN=
# Секрет, который Telegram присылает в заголовке вебхука
TELEGRAM_WEBHOOK_SECRET=
# Имя бота без @, для ссылки привязки
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=naryad_ai_bot

# ИИ: облачный провайдер DeepSeek (OpenAI-совместимый API)
DEEPSEEK_API_KEY=
# Локальный режим (AI_PROVIDER=local): Ollama
OLLAMA_URL=http://localhost:11434
# Модели для локального режима (Ollama)
OLLAMA_TEXT_MODEL=qwen2.5vl:7b
OLLAMA_VISION_MODEL=qwen2.5vl:7b
# Разбор надиктованного наряда по полям (Qwen3-4B, Apache 2.0). Mac выключен — облако с обезличиванием.
OLLAMA_VOICE_MODEL=qwen3:4b-instruct-2507-q4_K_M

# Быстрый слой Laya (services/fast-ai). Включать только когда сервис запущен.
LAYA_ENABLED=0
FAST_AI_URL=
FAST_AI_SECRET=

# Android-приложение (TWA): отпечаток SHA-256 ключа подписи для /.well-known/assetlinks.json (apps/android/README.md)
ANDROID_PACKAGE_ID=kz.naryadai.app
ANDROID_SHA256_FINGERPRINTS=
